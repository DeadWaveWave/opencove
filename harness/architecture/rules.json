{
  "sourceRoot": "src",
  "includeExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"],
  "exclude": ["**/*.d.ts", "**/*.spec.ts", "**/*.test.ts", "**/*.spec.tsx", "**/*.test.tsx"],
  "aliases": [
    {
      "prefix": "@/",
      "path": "src/"
    },
    {
      "prefix": "@app/",
      "path": "src/app/"
    },
    {
      "prefix": "@contexts/",
      "path": "src/contexts/"
    },
    {
      "prefix": "@platform/",
      "path": "src/platform/"
    },
    {
      "prefix": "@shared/",
      "path": "src/shared/"
    }
  ],
  "contexts": {
    "root": "src/contexts",
    "entryFiles": [
      "domain/index.ts",
      "application/index.ts",
      "infrastructure/index.ts",
      "presentation/main-ipc/index.ts",
      "presentation/renderer/index.ts"
    ],
    "restrictedLayerDirs": ["infrastructure", "presentation"]
  },
  "variantRules": {
    "literalDecision": { "severity": "warn" },
    "switchExhaustive": { "severity": "warn" },
    "doc": "docs/architecture/ARCHITECTURE.md#variants-and-registries",
    "assertNeverFile": "src/shared/utils/assertNever.ts",
    "variants": [
      {
        "id": "agentProvider",
        "source": { "file": "src/shared/contracts/dto/agent.ts", "export": "AGENT_PROVIDER_IDS" },
        "descriptorFiles": ["src/shared/contracts/agentProviderDescriptors.ts"],
        "ownerGlobs": {
          "claude-code": ["src/contexts/agent/infrastructure/providers/claude-code/**"],
          "codex": ["src/contexts/agent/infrastructure/providers/codex/**"],
          "opencode": ["src/contexts/agent/infrastructure/providers/opencode/**"],
          "gemini": ["src/contexts/agent/infrastructure/providers/gemini/**"],
          "pi": ["src/contexts/agent/infrastructure/providers/pi/**"],
          "kimi": ["src/contexts/agent/infrastructure/providers/kimi/**"]
        },
        "subjectPattern": null,
        "allowExitGuards": false
      },
      {
        "id": "nodeKind",
        "source": {
          "file": "src/shared/contracts/persistedAppState.ts",
          "export": "PERSISTED_WORKSPACE_NODE_KINDS"
        },
        "descriptorFiles": [],
        "ownerGlobs": {},
        "subjectPattern": "kind$",
        "allowExitGuards": true
      }
    ]
  },
  "layers": [
    {
      "name": "domain",
      "patterns": ["src/contexts/*/domain/**"]
    },
    {
      "name": "application",
      "patterns": ["src/contexts/*/application/**"]
    },
    {
      "name": "infrastructure",
      "patterns": ["src/contexts/*/infrastructure/**"]
    },
    {
      "name": "presentation-main",
      "patterns": ["src/contexts/*/presentation/main-ipc/**"]
    },
    {
      "name": "presentation-renderer",
      "patterns": ["src/contexts/*/presentation/renderer/**"]
    },
    {
      "name": "app-main",
      "patterns": ["src/app/main/**"]
    },
    {
      "name": "app-preload",
      "patterns": ["src/app/preload/**"]
    },
    {
      "name": "app-renderer",
      "patterns": ["src/app/renderer/**"]
    },
    {
      "name": "app-worker",
      "patterns": ["src/app/worker/**"]
    },
    {
      "name": "app-managed-runtime",
      "patterns": ["src/app/managedRuntime/**"]
    },
    {
      "name": "app-cli",
      "patterns": ["src/app/cli/**"]
    },
    {
      "name": "platform",
      "patterns": ["src/platform/**"]
    },
    {
      "name": "shared",
      "patterns": ["src/shared/**"]
    }
  ],
  "allowedLayerDependencies": [
    {
      "from": "domain",
      "to": ["domain", "shared"]
    },
    {
      "from": "application",
      "to": ["application", "domain", "shared"]
    },
    {
      "from": "infrastructure",
      "to": ["infrastructure", "application", "domain", "shared", "platform"]
    },
    {
      "from": "presentation-main",
      "to": ["presentation-main", "application", "domain", "shared"]
    },
    {
      "from": "presentation-renderer",
      "to": ["presentation-renderer", "application", "domain", "shared"]
    },
    {
      "from": "app-main",
      "to": [
        "app-main",
        "presentation-main",
        "application",
        "infrastructure",
        "domain",
        "shared",
        "platform"
      ]
    },
    {
      "from": "app-preload",
      "to": ["app-preload", "shared"]
    },
    {
      "from": "app-renderer",
      "to": ["app-renderer", "presentation-renderer", "domain", "shared"]
    },
    {
      "from": "app-worker",
      "to": ["app-worker", "app-main", "shared"]
    },
    {
      "from": "app-cli",
      "to": ["app-cli", "shared"]
    },
    {
      "from": "app-managed-runtime",
      "to": ["application", "infrastructure", "shared"]
    },
    {
      "from": "platform",
      "to": ["platform", "shared"]
    },
    {
      "from": "shared",
      "to": ["shared"]
    }
  ],
  "checks": {
    "fileRuntimeCycles": {
      "severity": "error"
    },
    "layerDependencies": {
      "severity": "warn",
      "ignoreTypeOnly": true,
      "allowedEdges": [
        {
          "fromPatterns": ["src/app/renderer/shell/hooks/useWorkspaceMountRepair.ts"],
          "reason": "Renderer composition hook that injects the workspace mount-repair application owner; the owner stays the single writer and the hook only wires it.",
          "toLayers": ["application"],
          "toPatterns": [
            "src/contexts/workspace/application/mountRepair/WorkspaceMountRepairOwner.ts"
          ]
        },
        {
          "fromPatterns": ["src/app/worker/workerWebAccessRuntime.ts"],
          "reason": "Worker composition root: wires the settings worker-web-access owner and its types into the headless runtime. The owner holds the state; the worker only hosts it.",
          "toLayers": ["application", "domain"],
          "toPatterns": [
            "src/contexts/settings/application/workerWebAccess/workerWebAccessOwner.ts",
            "src/contexts/settings/application/workerWebAccess/workerWebAccessTypes.ts",
            "src/contexts/settings/domain/homeWorkerConfig.ts"
          ]
        },
        {
          "fromPatterns": ["src/app/worker/workerConfigurationOwner.ts"],
          "reason": "Worker composition root: binds the home-worker configuration owner to its file-backed infrastructure (config file and web UI password).",
          "toLayers": ["application", "infrastructure"],
          "toPatterns": [
            "src/contexts/settings/application/homeWorkerConfigurationOwner.ts",
            "src/contexts/settings/infrastructure/homeWorker/homeWorkerConfig.ts",
            "src/contexts/settings/infrastructure/homeWorker/webUiPassword.ts"
          ]
        },
        {
          "fromPatterns": ["src/app/worker/workerConfigurationHandlers.ts"],
          "reason": "Worker control-surface handlers that apply the home-worker configuration policy owned by the settings application layer.",
          "toLayers": ["application"],
          "toPatterns": ["src/contexts/settings/application/homeWorkerConfigurationPolicy.ts"]
        },
        {
          "fromPatterns": ["src/app/worker/desktopManagedControlSurface.ts"],
          "reason": "Desktop-managed worker must read the home-worker config file directly to find the running worker; no application port exists for this bootstrap read.",
          "toLayers": ["infrastructure"],
          "toPatterns": ["src/contexts/settings/infrastructure/homeWorker/homeWorkerConfig.ts"]
        },
        {
          "fromPatterns": ["src/app/worker/headlessPtyRuntime.ts"],
          "reason": "Headless worker hosts the terminal PTY runtime outside Electron main, so it wires the session state watcher, crash host, engine port and profile resolver directly.",
          "toLayers": ["presentation-main", "application", "platform"],
          "toPatterns": [
            "src/contexts/terminal/presentation/main-ipc/sessionStateWatcher.ts",
            "src/contexts/terminal/presentation/main-ipc/debugCrashHost.ts",
            "src/contexts/terminal/application/ports/TerminalProcessEnginePort.ts",
            "src/platform/terminal/TerminalProfileResolver.ts"
          ]
        },
        {
          "fromPatterns": ["src/app/worker/index.ts"],
          "reason": "Worker entry point and composition root: wires settings, workspace approval, agent provider and CLI environment infrastructure at startup.",
          "toLayers": ["application", "infrastructure", "platform"],
          "toPatterns": [
            "src/contexts/workspace/infrastructure/approval/ApprovedWorkspaceStoreCore.ts",
            "src/platform/os/CliEnvironment.ts",
            "src/contexts/settings/infrastructure/homeWorker/webUiPassword.ts",
            "src/contexts/settings/infrastructure/homeWorker/homeWorkerConfig.ts",
            "src/contexts/settings/infrastructure/homeWorker/homeWorkerConfigLease.ts",
            "src/contexts/agent/application/services/AgentProviderRegistry.ts",
            "src/contexts/agent/infrastructure/providers/catalog/BuiltinAgentProviderCatalog.ts",
            "src/contexts/agent/infrastructure/cleanupLegacyManagedHooksAtStartup.ts"
          ]
        }
      ],
      "doc": "docs/architecture/ARCHITECTURE.md#5-依赖规则"
    },
    "contextBoundaries": {
      "forbiddenLayer": { "severity": "warn" },
      "publicEntry": { "severity": "warn" },
      "entryShape": { "severity": "error" },
      "selfEntryImport": { "severity": "error" },
      "doc": "docs/architecture/ARCHITECTURE.md#5-依赖规则"
    },
    "forbiddenImportSpecifiers": [
      {
        "id": "architecture.domainNoOuterRuntime",
        "severity": "error",
        "fromLayers": ["domain"],
        "ignoreTypeOnly": false,
        "specifiers": ["electron", "react", "react-dom", "better-sqlite3"],
        "specifierPrefixes": ["node:", "@app/", "@platform/"],
        "doc": "docs/architecture/ARCHITECTURE.md#domain"
      },
      {
        "id": "architecture.applicationNoOuterRuntime",
        "severity": "error",
        "fromLayers": ["application"],
        "ignoreTypeOnly": false,
        "specifiers": ["electron", "react", "react-dom", "better-sqlite3"],
        "specifierPrefixes": ["@app/"],
        "doc": "docs/architecture/ARCHITECTURE.md#application"
      },
      {
        "id": "architecture.sharedNoContextDependency",
        "severity": "error",
        "fromLayers": ["shared"],
        "ignoreTypeOnly": false,
        "specifiers": [],
        "specifierPrefixes": ["@contexts/"],
        "toPatterns": ["src/contexts/**"],
        "doc": "docs/architecture/ARCHITECTURE.md#5-依赖规则"
      },
      {
        "id": "architecture.terminalRendererNoSettingsPresentation",
        "severity": "error",
        "fromLayers": ["presentation-renderer"],
        "fromPatterns": [
          "src/contexts/workspace/presentation/renderer/components/terminalNode/**",
          "src/contexts/workspace/presentation/renderer/components/workspaceCanvas/hooks/useTerminalDisplayMetrics.ts"
        ],
        "ignoreTypeOnly": false,
        "specifiers": [],
        "specifierPrefixes": ["@contexts/settings/presentation/"],
        "doc": "docs/architecture/ARCHITECTURE.md#5-依赖规则"
      },
      {
        "id": "architecture.settingsCalibrationNoWorkspacePresentation",
        "severity": "error",
        "fromLayers": ["presentation-renderer"],
        "fromPatterns": [
          "src/contexts/settings/presentation/renderer/terminalDisplay*.ts",
          "src/contexts/settings/presentation/renderer/useTerminalDisplay*.ts"
        ],
        "ignoreTypeOnly": false,
        "specifiers": [],
        "specifierPrefixes": ["@contexts/workspace/presentation/"],
        "doc": "docs/architecture/ARCHITECTURE.md#5-依赖规则"
      },
      {
        "id": "architecture.rendererNoElectronRuntime",
        "severity": "error",
        "fromLayers": ["app-renderer", "presentation-renderer"],
        "ignoreTypeOnly": false,
        "specifiers": ["electron", "better-sqlite3"],
        "specifierPrefixes": ["node:"],
        "doc": "docs/architecture/ARCHITECTURE.md#6-进程边界规则"
      },
      {
        "id": "architecture.rendererNoOperationRuntime",
        "severity": "error",
        "fromLayers": ["app-renderer", "presentation-renderer", "app-preload"],
        "ignoreTypeOnly": true,
        "specifiers": ["zod"],
        "specifierPrefixes": ["zod/"],
        "toPatterns": [
          "src/shared/contracts/controlSurface/operations",
          "src/shared/contracts/controlSurface/operations/**"
        ],
        "doc": "docs/architecture/CONTROL_SURFACE.md#adding-a-capability"
      }
    ],
    "forbiddenText": [
      {
        "id": "architecture.windowOpenCoveApiBoundary",
        "severity": "warn",
        "pattern": "window\\.opencoveApi",
        "allowedPatterns": [
          "src/app/preload/**",
          "src/app/renderer/browser/**",
          "src/**/presentation/renderer/*Api.ts",
          "src/**/presentation/renderer/**/*Api.ts",
          "src/**/presentation/renderer/**/testHarness.ts"
        ],
        "doc": "docs/architecture/ARCHITECTURE.md#windowopencoveapi"
      }
    ],
    "rendererBridge": {
      "id": "architecture.rendererBridgeBoundary",
      "severity": "error",
      "clients": ["src/app/renderer/bootstrap/installDesktopOpenCoveApi.ts"],
      "doc": "docs/architecture/ARCHITECTURE.md#windowopencoveapi",
      "pluginDiagnosticFormatters": [
        "src/contexts/plugins/presentation/renderer/pluginErrorMessage.ts"
      ]
    }
  }
}
