// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`documents context offline 1`] = `
"Usage: opencove context [options]

Show your project, space and neighboring nodes

With no explicit target, inside OpenCove defaults to your own space. Terminals outside any space show their project with space: null and no neighbors. Outside OpenCove, provide --space or --project. An explicit project selects its active space. self is your caller identity (null outside OpenCove); project and space describe the target you asked about, which may differ from self. For agent nodes, state is the Worker run state (idle, working, waiting, exited or unknown) from agent.list; missing observations are unknown, never inferred from lifecycle. sessionStatus preserves the agent session lifecycle (for example running). For tasks, state is task status; for terminals, state remains session lifecycle; for other nodes it is null.

When no project is given, inside OpenCove defaults to your own project.

Options:
  --space <id>    Orient yourself in this space; also accepts @self, an exact name or a unique ID prefix (6+ characters)
  --project <id>  Orient yourself in this project; also accepts @self, an exact name or a unique ID prefix (6+ characters)

Table output (-o table): not supported.
Projectable fields: self, self.caller, self.scope, self.projectId, self.spaceId, self.nodeId, self.sessionId, project, project.id, project.name, project.path, space, space.id, space.name, space.directory, nodes, nodes.id, nodes.kind, nodes.title, nodes.state, nodes.sessionStatus, next

Projection example:
  opencove context --space "@self" --fields space.name
  {"space":{"name":"Main"}}

Examples:
  opencove context --space "@self"
  opencove context --project project-123 --fields project,space,next

Global options: see "opencove --help".
"
`;

exports[`documents node get offline 1`] = `
"Usage: opencove node get --node <id> [options]

Get a canvas node

data.status is task status; top-level status is agent or terminal runtime status.

Options:
  --node <id>     Select a canvas node by its ID; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required)
  --project <id>  Narrow target lookup to a project; also accepts @self, an exact name or a unique ID prefix (6+ characters)

Table output (-o table): not supported.
Projectable fields: id, kind, title, projectId, spaceId, frame, frame.x, frame.y, frame.width, frame.height, status, sessionId, data, data.kind, data.content, data.text, data.requirement, data.status, data.priority, data.tags, data.linkedAgentNodeId, data.url, data.pinned, data.sessionMode, data.profileId, data.provider, data.prompt, data.model, data.effectiveModel, data.executionDirectory, data.expectedDirectory, data.taskId, data.runtimeKind

Projection example:
  opencove node get --node '<id>' --fields id,title
  {"node":{"id":"n","title":"Note"}}

Examples:
  opencove node get --node node-123
  opencove node get --node node-123 --fields node.id,node.title

Global options: see "opencove --help".
"
`;

exports[`documents whoami offline 1`] = `
"Usage: opencove whoami [options]

Show your caller identity and permission scope

Inside an OpenCove terminal, caller is session-grant and scope is interact. With a desktop token, caller is bearer and scope is admin. projectId, spaceId, nodeId and sessionId are null when the caller has no session identity; spaceId is also null for a node outside any space. Credentials are never printed.

Table output (-o table): not supported.
Projectable fields: caller, scope, projectId, spaceId, nodeId, sessionId

Projection example:
  opencove whoami --fields caller,scope
  {"caller":"session-grant","scope":"interact"}

Examples:
  opencove whoami
  opencove whoami --fields caller,scope,nodeId

Global options: see "opencove --help".
"
`;
