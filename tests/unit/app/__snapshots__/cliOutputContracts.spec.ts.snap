// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`projection help golden mount create 1`] = `
"Usage: opencove mount create [--project <id>] --endpoint-id <id> --root-path <path> [options]

Mount a worker folder in a project

When no project is given, inside OpenCove defaults to your own project.

Options:
  --project <id>      Select the project; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required outside OpenCove)
  --endpoint-id <id>  Select the endpoint (required)
  --root-path <path>  Mount this absolute folder path (required)
  --name <name>       Name the mount

Table output (-o table): not supported.
Projectable fields: mountId, projectId, name, sortOrder, endpointId, targetId, rootPath, rootUri, createdAt, updatedAt

Projection example:
  opencove mount create --project '<id>' --endpoint-id '<id>' --root-path '<path>' --fields mountId
  {"mount":{"mountId":"m"}}

Examples:
  opencove mount create --project project-123 --endpoint-id endpoint-id-123 --root-path /workspace

Global options: see "opencove --help".
"
`;

exports[`projection help golden plugin details 1`] = `
"Usage: opencove plugin details <id> [options]

Inspect plugin metadata

Table output (-o table): not supported.
Projectable fields: id, version, displayName, description, icon, nodeKinds, actionBar, contextMenu, source, author, revision, runtimeGeneration, enabled, status, error, view, hasPreview, commands, skills, preferences, sidebar, themes, icon.type, icon.name, icon.path, icon.light, icon.dark, view.entry, view.instances, view.kind, view.width, view.height, view.minWidth, view.minHeight

Projection example:
  opencove plugin details '<id>' --fields id
  {"plugin":{"id":"sample"},"readme":"Documentation","assets":{},"sourceDirectory":null,"logs":[]}

Examples:
  opencove plugin details sample

Global options: see "opencove --help".
"
`;

exports[`projection help golden plugin list 1`] = `
"Usage: opencove plugin list [options]

List installed plugins

List output: --limit <n> keeps up to n items per list; 0 means all. Cut object lists add top-level truncated totals; bare arrays keep their shape and write one stderr notice. Cut tables also write one stderr notice.

Table output (-o table): not supported.
Projectable fields: id, version, displayName, description, icon, nodeKinds, actionBar, contextMenu, source, author, revision, runtimeGeneration, enabled, status, error, view, hasPreview, commands, skills, preferences, sidebar, themes, icon.type, icon.name, icon.path, icon.light, icon.dark, view.entry, view.instances, view.kind, view.width, view.height, view.minWidth, view.minHeight

Projection example:
  opencove plugin list --fields id
  {"plugins":[{"id":"sample"}]}

Examples:
  opencove plugin list

Global options: see "opencove --help".
"
`;

exports[`projection help golden plugin reload 1`] = `
"Usage: opencove plugin reload <id> [options]

Reload a plugin

Table output (-o table): not supported.
Projectable fields: id, version, displayName, description, icon, nodeKinds, actionBar, contextMenu, source, author, revision, runtimeGeneration, enabled, status, error, view, hasPreview, commands, skills, preferences, sidebar, themes, icon.type, icon.name, icon.path, icon.light, icon.dark, view.entry, view.instances, view.kind, view.width, view.height, view.minWidth, view.minHeight

Projection example:
  opencove plugin reload '<id>' --fields id
  {"status":"updated","candidateId":"c","candidateDirectory":"/plugins/c","plugin":{"id":"sample"}}

Examples:
  opencove plugin reload sample

Global options: see "opencove --help".
"
`;

exports[`projection help golden plugin run 1`] = `
"Usage: opencove plugin run <id> <command> [options]

Run a plugin command

Inside OpenCove, window commands without an explicit node or project default to your own project. Plugin-wide commands receive no default target.

Options:
  --project <id>          Select the project; also accepts @self, an exact name or a unique ID prefix (6+ characters)
  --node <id>             Select an existing plugin window; also accepts @self, an exact name or a unique ID prefix (6+ characters)
  --view <id>             Select the plugin view
  --params <json>         Pass command parameters as JSON
  --params-file <path|->  Read params from a UTF-8 file, or use - for stdin
  --space <selector>      Require every node selector, including full IDs, to belong to this space; also accepts @self, an exact name or a unique ID prefix (6+ characters)

Table output (-o table): not supported.
Field projection (--fields): not supported. Plugin commands define their own results, so fields cannot be validated before execution. Omit --fields to receive the complete result.

Examples:
  opencove plugin run sample status

Global options: see "opencove --help".
"
`;

exports[`projection help golden worker status 1`] = `
"Usage: opencove worker status [options]

Inspect local worker status

Options:
  --all  Include stopped worker records

List output: --limit <n> keeps up to n items per list; 0 means all. Cut object lists add top-level truncated totals; bare arrays keep their shape and write one stderr notice. Cut tables also write one stderr notice.

Table output (-o table): not supported.
Projectable fields: pid, status, hostname, port, userDataPath, startedBy, appVersion, createdAt, reachable

Projection example:
  opencove worker status --fields pid
  {"status":"running","workers":[{"pid":42}]}

Examples:
  opencove worker status

Global options: see "opencove --help".
"
`;

exports[`projection help golden worktree create 1`] = `
"Usage: opencove worktree create [--space <id>] [options]

Create a worktree for a space

When no target is given, inside OpenCove defaults to your own space; project options default to your own project.

Options:
  --space <id>     Select the space; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required outside OpenCove)
  --name <branch>  Name the worktree branch
  -q, --quiet      Print only the created object identifier followed by a newline
  --project <id>   Narrow target lookup to a project; also accepts @self, an exact name or a unique ID prefix (6+ characters)

Table output (-o table): not supported.
Projectable fields: path, head, branch

Projection example:
  opencove worktree create --space '<id>' --fields path
  {"projectId":"p","activeSpaceId":"s","spaceId":"s","spaceDirectoryPath":"/repo","spaceName":"Main","worktree":{"path":"/repo"}}

Examples:
  opencove worktree create --space space-123

Global options: see "opencove --help".
"
`;
