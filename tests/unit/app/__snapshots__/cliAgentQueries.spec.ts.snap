// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`agent  help is offline and complete 1`] = `
"Usage: opencove agent <command> [options]

Commands:
  delivery         Check retained delivery evidence; never resends input
  history <clear>  History canvas targets
  list             List live agent run states and node titles
  get              Inspect an agent run-state snapshot with its node title
  prompt           Send a prompt to an agent window OpenCove launched
  wait             Wait until agents reach a state or finish a turn
  read             Read an agent reply or inspect its current terminal screen

Global options: see "opencove --help".
"
`;

exports[`agent get help is offline and complete 1`] = `
"Usage: opencove agent get --node <id> [options]

Inspect an agent run-state snapshot with its node title

Returns the Worker snapshot plus title, including observed agents inside terminal nodes. A node without registered run state fails with agent.not_found (exit 1); use node get to inspect a terminal/note, or start/resume an agent window. State is runtime evidence, independent of persisted node status. Unknown/degraded is never ready. lastEndedTurn identifies the most recent ended turn with {id, outcome, endedAt} (epoch milliseconds), or null before any end in this incarnation. It persists while the next turn runs and resets on replacement/restart. turnOutcome keeps its legacy behavior: set on end (completed, failed, aborted or unknown), usually cleared on the next start; use lastEndedTurn for identity-bound results.

Options:
  --node <id>         Select a canvas node by its ID; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required)
  --space <selector>  Require every node selector, including full IDs, to belong to this space; also accepts @self, an exact name or a unique ID prefix (6+ characters)
  --project <id>      Narrow target lookup to a project; also accepts @self, an exact name or a unique ID prefix (6+ characters)

Table output (-o table): not supported.
Projectable fields: nodeId, title, sessionId, provider, state, blockedReason, turn, turn.id, turn.startedAt, turn.start, lastTransitionAt, source, quality, turnOutcome, lastEndedTurn, lastEndedTurn.id, lastEndedTurn.outcome, lastEndedTurn.endedAt

Projection example:
  opencove agent get --node '<id>' --fields nodeId
  {"nodeId":"node-123"}

Examples:
  opencove agent get --node "Reviewer" --pretty
  opencove agent get --node @self --fields state,quality,turn

Global options: see "opencove --help".
"
`;

exports[`agent list help is offline and complete 1`] = `
"Usage: opencove agent list [options]

List live agent run states and node titles

Returns {epoch, seq, agents}, one row per live agent session. Exited sessions are excluded by agent.list (so --state exited returns no rows); use agent get or wait for a known exited node. Titles come from node metadata; null means unbound or deleted. turn.startedAt is epoch milliseconds, or absent when no turn is active. Inside OpenCove, the default scope is your space; --project selects a whole project.

When no target is given, inside OpenCove defaults to your own space; project options default to your own project.

Options:
  --space <id>                                   Select a space by its ID; also accepts @self, an exact name or a unique ID prefix (6+ characters)
  --state <working|waiting|idle|exited|unknown>  Filter the authoritative run state
  --project <id>                                 Narrow target lookup to a project; also accepts @self, an exact name or a unique ID prefix (6+ characters)

List output: --limit <n> keeps up to n items per list; 0 means all. Cut object lists add top-level truncated totals; bare arrays keep their shape and write one stderr notice. Cut tables also write one stderr notice.

Table output (-o table): supported.
Projectable fields: nodeId, title, sessionId, provider, state, blockedReason, turn, turn.id, turn.startedAt, turn.start, lastTransitionAt, source, quality, turnOutcome, lastEndedTurn, lastEndedTurn.id, lastEndedTurn.outcome, lastEndedTurn.endedAt

Projection example:
  opencove agent list --fields nodeId
  {"epoch":"e","seq":1,"agents":[{"nodeId":"node-123"}]}

Examples:
  opencove agent list -o table
  opencove agent list --space "Review" --state waiting --fields nodeId,title,state,blockedReason

Global options: see "opencove --help".
"
`;

exports[`agent read help is offline and complete 1`] = `
"Usage: opencove agent read --node <id> [options]

Read an agent reply or inspect its current terminal screen

Reads agent.finalMessage first: the latest observed ended turn, or exactly --turn <turnId> from agent prompt. --turn never uses prefixes, another turn or a transcript fallback. --last makes the latest-turn default explicit and can accompany --turn.

Only an unqualified hook read reporting no_ended_turn or provider_sent_no_message falls back to session.finalMessage, including restored conversations. Other errors are preserved. Hook content, including empty or whitespace-only messages, wins. Exact-turn errors use agent.final_message_unavailable with details.reason: turn_not_ended (still active), turn_not_found (unknown/evicted), no_ended_turn, provider_sent_no_message, archive_unavailable, or remote_history_unavailable. CLI errors retain code/reason and include known nodeId/sessionId/turnId plus concrete recovery commands: wait for a running turn, inspect agent get for missing history, or inspect --screen/session final for unavailable content.

Plain message text goes to stdout even when piped. -o json or --fields returns structured data: hook results have nodeId, sessionId, turnId, optional promptId, outcome, persisted, optional memoryOnlyReason, message, truncated and source: hook; transcript results have sessionId, provider, startedAt, cwd, resumeSessionId, message, truncated: false and source: transcript. A cut hook message prints one stderr notice with transcript/screen recovery commands; it never automatically replaces the retained prefix.

Claude messages queued mid-turn continue the same OpenCove turn, including provider follow-ups. Exact reads return its final reply after all continuations. An unknown continuation outcome marks the last provider reply with messageKind: intermediate and prints a notice. After wait --until idle, read returns only the latest ended turn reply.

After agent prompt, retain its turnId, run "opencove agent wait --node <selector> --turn <turnId>", then "opencove agent read --node <selector> --turn <turnId>". Exact --turn reads survive Worker restarts for archived local turns. The private archive stores final replies up to 64 KiB, outcome and IDs: at most 60 turns per node, 30 days, 20,000 global records and 128 MiB of message text. JSON reports persisted and a memoryOnlyReason when false. Deleting the node removes OpenCove history, not provider transcripts or existing backups. Unqualified reads remain current-incarnation reads. Remote wait --turn uses mirrored snapshots/events; older remote turns can only be checked on the Worker that runs them (remote_history_unavailable). Hook replies currently require local Claude hooks with correlated prompt IDs.

Use --screen before prompting to inspect drafts and dialogs. It resolves the current session, replays its presentation snapshot at its columns/rows, preserving cursor-created spaces, overwrites and wide CJK/emoji cells. It selects the normal or alternate buffer, ignores styling/mode sequences, trims row-end spaces and trailing blank rows, then returns the last --lines rendered rows (default: 40). -o json returns {nodeId, sessionId, lines: [...]}. Screen-mode projectable fields are nodeId, sessionId, lines; the field list below applies to final-message mode. --lines requires --screen; --screen conflicts with --last and --turn. This is a read only snapshot, not permission to answer another agent's dialog.

If transcript fallback has no readable message, session.transcript_not_ready exits 1. A working agent may need to reach idle first; an idle agent may have transcript saving disabled. Inspect --screen and check provider settings; waiting cannot create a transcript. Reading never sends input.

Options:
  --node <id>         Select a canvas node by its ID; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required)
  --last              Read the latest ended turn (default; --turn selects an exact turn)
  --turn <turnId>     Read exactly this OpenCove turn ID from agent prompt; never falls back
  --screen            Inspect the current terminal screen as plain text instead of the final message
  --lines <n>         Return the last n screen lines after trimming trailing blank lines (positive integer; default: 40; requires --screen)
  --space <selector>  Require every node selector, including full IDs, to belong to this space; also accepts @self, an exact name or a unique ID prefix (6+ characters)
  --project <id>      Narrow target lookup to a project; also accepts @self, an exact name or a unique ID prefix (6+ characters)

Table output (-o table): not supported.
Projectable fields: nodeId, sessionId, turnId, promptId, outcome, persisted, memoryOnlyReason, message, messageKind, truncated, source, provider, startedAt, cwd, resumeSessionId

Projection example:
  opencove agent read --node '<id>' --fields nodeId
  {"nodeId":"node-123"}

Examples:
  opencove agent read --node "Reviewer" --screen
  opencove agent read --node "Reviewer" --screen --lines 20 -o json
  opencove agent read --node "Reviewer" --last
  opencove agent read --node node-123 --turn turn-123
  opencove agent read --node node-123 --turn turn-123 -o json

Global options: see "opencove --help".
"
`;

exports[`agent wait help is offline and complete 1`] = `
"Usage: opencove agent wait --node <selector> (--turn <turnId> | --until idle|waiting|exited|turn-end [--node <selector> ...] [--any|--all]) [--timeout <duration>] [options]

Wait until agents reach a state or finish a turn

Waits without sending any input. A state that already holds counts immediately. idle requires no active turn and never accepts an unknown or degraded state. After "agent prompt", save turnId and use --turn <turnId> to wait for that exact turn, even if a newer turn has started.

--turn requires one node and conflicts with --until, multiple --node options and --any. It waits through permission/question pauses and Claude queued provider continuations within that turn. Returns {nodeId, sessionId, turnId, outcome, endedAt?, state, persisted, memoryOnlyReason?}; every ended outcome exits 0, including failed, aborted and unknown. Read outcome before claiming success. Exact archived local ends survive Worker restarts and can be read without a live agent. Unknown/evicted turns exit 1; archive_unavailable is distinct. Inspect persisted before relying on restart durability.

Local exact history retains at most 60 turns per node for 30 days, with global caps of 20,000 records and 128 MiB. For remote agents, --turn uses mirrored snapshots/events; older turns can only be checked on the Worker that runs them. Missing remote history reports details.reason: remote_history_unavailable, not eviction.

State waits follow the current session; exact archived turn waits return the original session independently. Exact-turn errors keep their code and details.reason, include known nodeId/sessionId/turnId, and suggest concrete agent get, --screen or session final commands.

--until turn-end waits for a turn to finish after this command starts; use it only when you start waiting while the turn is still running. A finished turn is not necessarily a successful one: check turnOutcome (or endedTurnOutcome for turn-end).

With several --node options, --all (default) waits until every agent matches and --any until the first one does. The result lists the latest state of every selected agent. Budgets below 250ms are rejected with usage exit 2 before connecting. On timeout (default 20s) it exits 124, prints the last known states on stderr and nothing on stdout; Ctrl-C exits 130. The agents keep running either way.

Options:
  --node <id>                             Select a canvas node by its ID; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required)
  --until <idle|waiting|exited|turn-end>  Condition to observe
  --turn <turnId>                         Exact OpenCove turn ID returned by agent prompt
  --any                                   Resolve when any selected node matches
  --all                                   Resolve when all selected nodes match (default)
  --timeout <duration>                    Overall wait budget, e.g. 30s, 2m or 20000ms (default: 20s; minimum: 250ms)
  --space <selector>                      Require every node selector, including full IDs, to belong to this space; also accepts @self, an exact name or a unique ID prefix (6+ characters)
  --project <id>                          Narrow target lookup to a project; also accepts @self, an exact name or a unique ID prefix (6+ characters)

List output: --limit <n> keeps up to n items per list; 0 means all. Cut object lists add top-level truncated totals; bare arrays keep their shape and write one stderr notice. Cut tables also write one stderr notice.

Table output (-o table): not supported.
Projectable fields: nodeId, sessionId, provider, state, blockedReason, turn, turn.id, turn.startedAt, turn.start, lastTransitionAt, source, quality, turnOutcome, lastEndedTurn, lastEndedTurn.id, lastEndedTurn.outcome, lastEndedTurn.endedAt, endedTurn, endedTurn.id, endedTurn.startedAt, endedTurn.start, endedTurnOutcome, turnId, outcome, endedAt, persisted, memoryOnlyReason

Projection example:
  opencove agent wait --node node-123 --until idle --fields nodeId,state
  {"until":"idle","mode":"all","agents":[{"nodeId":"node-123","state":"idle"}]}

Examples:
  opencove agent wait --node node-123 --turn turn-123 --timeout 2m
  opencove agent wait --node "Reviewer" --until idle --timeout 2m
  opencove agent wait --node node-123 --node node-456 --until waiting --any --timeout 30s

Global options: see "opencove --help".
"
`;

exports[`explains session.not_found and next steps 1`] = `
{
  "code": "session.not_found",
  "hint": "Run opencove node list to check the selector, then start or resume its agent session before reading.",
  "message": "No agent conversation was found for this node.",
}
`;

exports[`explains session.transcript_not_ready and next steps 1`] = `
{
  "code": "session.transcript_not_ready",
  "hint": "Use "opencove agent wait --node node-123456 --until idle", then read again. Inspect the terminal with "opencove agent read --node node-123456 --screen".",
  "message": "No readable final message is available for this session.",
}
`;

