exports[`lists real endpoint subcommands offline 1`] = `
"Usage: opencove endpoint <command> [options]

Commands:
  list      List registered endpoints
  register  Register a remote worker
  ping      Check a remote worker connection
  remove    Remove a registered endpoint

Global options: see "opencove --help".
"
`;

exports[`lists real fs subcommands offline 1`] = `
"Usage: opencove fs <command> [options]

Commands:
  read   Read a text file
  write  Write a text file
  stat   Inspect file metadata
  ls     List a directory

Global options: see "opencove --help".
"
`;

exports[`lists real mount subcommands offline 1`] = `
"Usage: opencove mount <command> [options]

Commands:
  list     List project mounts
  create   Mount a worker folder in a project
  resolve  Resolve a mount location
  remove   Remove a project mount

Global options: see "opencove --help".
"
`;

exports[`lists real plugin subcommands offline 1`] = `
"Usage: opencove plugin <command> [options]

Commands:
  guide        Read the plugin development and usage guide
  list         List installed plugins
  details      Inspect plugin metadata
  install      Install a plugin from a local directory
  reload       Reload a plugin
  uninstall    Uninstall a plugin
  enable       Enable a plugin
  disable      Disable a plugin
  install-git  Install a plugin from a Git repository
  source       Inspect the plugin source
  check        Check for a plugin update
  update       Prepare a plugin update
  apply        Apply a prepared plugin update
  rollback     Restore a previous plugin revision
  discover     Find available plugins
  run          Run a plugin command
  skill        Read a plugin skill
  open         Open a plugin window
  windows      List plugin windows

Global options: see "opencove --help".
"
`;

exports[`lists real pty subcommands offline 1`] = `
"Usage: opencove pty <command> [options]

Commands:
  attach          Stream terminal output until exit or Ctrl-C
  spawn-in-mount  Start a terminal in a mount

Global options: see "opencove --help".
"
`;

