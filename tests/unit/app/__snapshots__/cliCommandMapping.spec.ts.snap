exports[`help for [ 'pty', 'spawn-in-mount' ] is offline 1`] = `"Usage: opencove pty spawn-in-mount --mount <id> [options]\\n\\nStart a terminal in a mount\\n\\nOptions:\\n  --mount <id>       Select the mount (required)\\n  --cwd-uri <uri>    Start in this directory URI\\n  --shell <path>     Run this shell\\n  --profile-id <id>  Select the terminal profile\\n  --cols <count>     Set terminal columns\\n  --rows <count>     Set terminal rows\\n\\nTable output (-o table): not supported.\\nProjectable fields: sessionId, profileId, runtimeKind\\n\\nProjection example:\\n  opencove pty spawn-in-mount --mount '<id>' --fields sessionId\\n  {\\"sessionId\\":\\"s\\"}\\n\\nExamples:\\n  opencove pty spawn-in-mount --mount mount-123\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'runtime', 'inspect' ] is offline 1`] = `"Usage: opencove runtime inspect [options]\\n\\nInspect the runtime build\\n\\nTable output (-o table): not supported.\\nProjectable fields: schemaVersion, buildId, appVersion, channel, protocolVersion, ptyProtocolVersion, launchContractVersion, dataSchemaVersion\\n\\nProjection example:\\n  opencove runtime inspect --fields schemaVersion\\n  {\\"schemaVersion\\":1}\\n\\nExamples:\\n  opencove runtime inspect\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'runtime', 'prepare' ] is offline 1`] = `"Usage: opencove runtime prepare [options]\\n\\nPrepare a managed runtime deployment\\n\\nOptions:\\n  --stream-progress  Stream raw progress and diagnostics to stderr instead of a single JSON error document\\n\\nTable output (-o table): not supported.\\nProjectable fields: status\\n\\nProjection example:\\n  opencove runtime prepare --fields status\\n  {\\"status\\":\\"prepared\\"}\\n\\nExamples:\\n  opencove runtime prepare\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'runtime', 'verify' ] is offline 1`] = `"Usage: opencove runtime verify [options]\\n\\nVerify the runtime environment\\n\\nOptions:\\n  --stream-progress  Stream raw progress and diagnostics to stderr instead of a single JSON error document\\n\\nTable output (-o table): not supported.\\nProjectable fields: schemaVersion, buildId, appVersion, channel, protocolVersion, ptyProtocolVersion, launchContractVersion, dataSchemaVersion\\n\\nProjection example:\\n  opencove runtime verify --fields schemaVersion\\n  {\\"build\\":{\\"schemaVersion\\":1},\\"platform\\":\\"darwin\\",\\"arch\\":\\"arm64\\",\\"nodeAbi\\":\\"127\\",\\"engine\\":\\"node\\"}\\n\\nExamples:\\n  opencove runtime verify\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'session', 'final' ] is offline 1`] = `"Usage: opencove session final --session <id> [options]\\n\\nRead the final agent message\\n\\nReturns the final message as JSON. A null, empty or whitespace-only message is no readable final message: exits 1 with session.transcript_not_ready, the same state-aware recovery as agent read, and empty stdout. The server does not distinguish a genuine empty reply. Inspect agent read --screen if the provider has not written a readable transcript.\\n\\nOptions:\\n  --session <id>  Select the session (required)\\n\\nTable output (-o table): not supported.\\nProjectable fields: sessionId, provider, startedAt, cwd, resumeSessionId, message\\n\\nProjection example:\\n  opencove session final --session s --fields message\\n  {\\"message\\":\\"Done\\"}\\n\\nExamples:\\n  opencove session final --session session-123\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'session', 'get' ] is offline 1`] = `"Usage: opencove session get --session <id> [options]\\n\\nInspect an agent session\\n\\nOptions:\\n  --session <id>  Select the session (required)\\n\\nTable output (-o table): not supported.\\nProjectable fields: sessionId, spawnedBy, lineageDepth, lineageStatus, provider, startedAt, cwd, prompt, model, effectiveModel, executionContext, resumeSessionId, command, args\\n\\nProjection example:\\n  opencove session get --session s --fields sessionId\\n  {\\"sessionId\\":\\"s\\"}\\n\\nExamples:\\n  opencove session get --session session-123\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'session', 'kill' ] is offline 1`] = `"Usage: opencove session kill --session <id> [options]\\n\\nStop an agent session\\n\\nOptions:\\n  --session <id>  Select the session (required)\\n\\nTable output (-o table): not supported.\\nField projection (--fields): not supported. This command returns no result fields. Omit --fields.\\n\\nExamples:\\n  opencove session kill --session session-123\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'session', 'run-agent' ] is offline 1`] = `"Usage: opencove session run-agent [--space <id>] --prompt <text> [options]\\n\\nLaunch an agent in a space\\n\\nWhen no target is given, inside OpenCove defaults to your own space; project options default to your own project.\\n\\nOptions:\\n  --space <id>            Select the space; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required outside OpenCove)\\n  --prompt <text>         Give the agent its task (required)\\n  --prompt-file <path|->  Read prompt from a UTF-8 file, or use - for stdin\\n  --provider <provider>   Select the agent provider\\n  --model <model>         Select the agent model\\n  --project <id>          Narrow target lookup to a project; also accepts @self, an exact name or a unique ID prefix (6+ characters)\\n\\nTable output (-o table): not supported.\\nProjectable fields: sessionId, spawnedBy, lineageDepth, lineageStatus, provider, startedAt, executionContext, profileId, runtimeKind, resumeSessionId, effectiveModel, command, args\\n\\nProjection example:\\n  opencove session run-agent --space '<id>' --prompt '<text>' --fields sessionId\\n  {\\"sessionId\\":\\"s\\"}\\n\\nExamples:\\n  opencove session run-agent --space space-123 --prompt \\"Review the project\\"\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'worker', 'start' ] is offline 1`] = `"Usage: opencove worker start [options]\\n\\nStart a local worker in the foreground\\n\\nOptions:\\n  --stream-progress              Stream raw diagnostics to stderr instead of a single JSON error document\\n  --hostname <host>              Listen on this host\\n  --advertise-hostname <host>    Advertise this reachable host\\n  --port <port>                  Listen on this port\\n  --web-ui-password <password>   Protect the web UI with this password\\n  --web-ui-password-hash <hash>  Use this web UI password hash\\n  --approve-root <path>          Approve a filesystem root for the worker\\n\\nTable output (-o table): not supported.\\nProjectable fields: status\\n\\nProjection example:\\n  opencove worker start --fields status\\n  {\\"status\\":\\"stopped\\"}\\n\\nExamples:\\n  opencove worker start\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'worker', 'status' ] is offline 1`] = `"Usage: opencove worker status [options]\\n\\nInspect local worker status\\n\\nOptions:\\n  --all  Include stopped worker records\\n\\nList output: --limit <n> keeps up to n items per list; 0 means all. Cut object lists add top-level truncated totals; bare arrays keep their shape and write one stderr notice. Cut tables also write one stderr notice.\\n\\nTable output (-o table): not supported.\\nProjectable fields: pid, status, hostname, port, userDataPath, startedBy, appVersion, createdAt, reachable\\n\\nProjection example:\\n  opencove worker status --fields pid\\n  {\\"status\\":\\"running\\",\\"workers\\":[{\\"pid\\":42}]}\\n\\nExamples:\\n  opencove worker status\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'worker', 'stop' ] is offline 1`] = `"Usage: opencove worker stop [options]\\n\\nStop a local worker\\n\\nOptions:\\n  --pid <pid>  Stop this worker process\\n  --force      Override ownership and reachability checks\\n\\nTable output (-o table): not supported.\\nProjectable fields: status, stopped, reason, pid, userDataPath, startedBy, forced\\n\\nProjection example:\\n  opencove worker stop --fields status\\n  {\\"status\\":\\"stopped\\"}\\n\\nExamples:\\n  opencove worker stop\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'worktree', 'archive' ] is offline 1`] = `"Usage: opencove worktree archive [--space <id>] [options]\\n\\nArchive a space worktree\\n\\nWhen no target is given, inside OpenCove defaults to your own space; project options default to your own project.\\n\\nOptions:\\n  --space <id>     Select the space; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required outside OpenCove)\\n  --force          Archive despite uncommitted changes\\n  --delete-branch  Delete the worktree branch\\n  --project <id>   Narrow target lookup to a project; also accepts @self, an exact name or a unique ID prefix (6+ characters)\\n\\nTable output (-o table): not supported.\\nProjectable fields: deletedBranchName, branchDeleteError, directoryCleanupError\\n\\nProjection example:\\n  opencove worktree archive --space '<id>' --fields deletedBranchName\\n  {\\"projectId\\":\\"p\\",\\"activeSpaceId\\":\\"s\\",\\"spaceId\\":\\"s\\",\\"spaceDirectoryPath\\":\\"/repo\\",\\"removed\\":{\\"deletedBranchName\\":\\"branch\\"}}\\n\\nExamples:\\n  opencove worktree archive --space space-123\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'worktree', 'create' ] is offline 1`] = `"Usage: opencove worktree create [--space <id>] [options]\\n\\nCreate a worktree for a space\\n\\nWhen no target is given, inside OpenCove defaults to your own space; project options default to your own project.\\n\\nOptions:\\n  --space <id>     Select the space; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required outside OpenCove)\\n  --name <branch>  Name the worktree branch\\n  -q, --quiet      Print only the created object identifier followed by a newline\\n  --project <id>   Narrow target lookup to a project; also accepts @self, an exact name or a unique ID prefix (6+ characters)\\n\\nTable output (-o table): not supported.\\nProjectable fields: path, head, branch\\n\\nProjection example:\\n  opencove worktree create --space '<id>' --fields path\\n  {\\"projectId\\":\\"p\\",\\"activeSpaceId\\":\\"s\\",\\"spaceId\\":\\"s\\",\\"spaceDirectoryPath\\":\\"/repo\\",\\"spaceName\\":\\"Main\\",\\"worktree\\":{\\"path\\":\\"/repo\\"}}\\n\\nExamples:\\n  opencove worktree create --space space-123\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'worktree', 'list' ] is offline 1`] = `"Usage: opencove worktree list [options]\\n\\nList Git worktrees\\n\\nWhen no project is given, inside OpenCove defaults to your own project.\\n\\nOptions:\\n  --project <id>  Select the project; also accepts @self, an exact name or a unique ID prefix (6+ characters)\\n\\nList output: --limit <n> keeps up to n items per list; 0 means all. Cut object lists add top-level truncated totals; bare arrays keep their shape and write one stderr notice. Cut tables also write one stderr notice.\\n\\nTable output (-o table): not supported.\\nProjectable fields: path, head, branch\\n\\nProjection example:\\n  opencove worktree list --fields path\\n  {\\"projectId\\":\\"p\\",\\"repoPath\\":\\"/repo\\",\\"worktreesRoot\\":\\"/trees\\",\\"worktrees\\":[{\\"path\\":\\"/repo\\"}]}\\n\\nExamples:\\n  opencove worktree list\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;
