exports[`help for [ 'plugin', 'open' ] is offline 1`] = `"Usage: opencove plugin open <id> [options]\\n\\nOpen a plugin window\\n\\nWhen no target is given, inside OpenCove defaults to your own space; project options default to your own project.\\n\\nOptions:\\n  --project <id>  Select the project; also accepts @self, an exact name or a unique ID prefix (6+ characters)\\n  --node <id>     Select an existing plugin window; also accepts @self, @parent, an exact name or a unique ID prefix (6+ characters)\\n  --space <id>    Place a new window here, or narrow an existing node lookup to this space; also accepts @self, an exact name or a unique ID prefix (6+ characters)\\n\\nTable output (-o table): not supported.\\nProjectable fields: nodeId, projectId, spaceId, title, titlePinnedByUser, created, revision, deliveredClientCount\\n\\nProjection example:\\n  opencove plugin open '<id>' --fields nodeId\\n  {\\"nodeId\\":\\"n\\"}\\n\\nExamples:\\n  opencove plugin open sample\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

