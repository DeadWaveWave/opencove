exports[`help for [ 'endpoint', 'list' ] is offline 1`] = `"Usage: opencove endpoint list [options]\\n\\nList registered endpoints\\n\\nList output: --limit <n> keeps up to n items per list; 0 means all. Cut object lists add top-level truncated totals; bare arrays keep their shape and write one stderr notice. Cut tables also write one stderr notice.\\n\\nTable output (-o table): not supported.\\nProjectable fields: endpointId, kind, displayName, createdAt, updatedAt, access, remote, remote.hostname, remote.port\\n\\nProjection example:\\n  opencove endpoint list --fields endpointId\\n  {\\"endpoints\\":[{\\"endpointId\\":\\"local\\"}]}\\n\\nExamples:\\n  opencove endpoint list\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'endpoint', 'ping' ] is offline 1`] = `"Usage: opencove endpoint ping --endpoint-id <id> [options]\\n\\nCheck a remote worker connection\\n\\nOptions:\\n  --endpoint-id <id>   Select the endpoint (required)\\n  --ping-timeout <ms>  Limit the remote ping duration\\n\\nTable output (-o table): not supported.\\nProjectable fields: ok, endpointId, now, pid\\n\\nProjection example:\\n  opencove endpoint ping --endpoint-id '<id>' --fields ok\\n  {\\"ok\\":true}\\n\\nExamples:\\n  opencove endpoint ping --endpoint-id endpoint-id-123\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'endpoint', 'register' ] is offline 1`] = `"Usage: opencove endpoint register --hostname <host> --port <port> --remote-token <token> [options]\\n\\nRegister a remote worker\\n\\nOptions:\\n  --hostname <host>       Connect to this worker host (required)\\n  --port <port>           Connect to this worker port (required)\\n  --remote-token <token>  Authenticate with the remote worker token (required)\\n  --display-name <name>   Name the worker connection\\n\\nTable output (-o table): not supported.\\nProjectable fields: endpointId, kind, displayName, createdAt, updatedAt, access, remote, remote.hostname, remote.port\\n\\nProjection example:\\n  opencove endpoint register --hostname '<host>' --port 39291 --remote-token '<token>' --fields endpointId\\n  {\\"endpoint\\":{\\"endpointId\\":\\"remote\\"}}\\n\\nExamples:\\n  opencove endpoint register --hostname worker.example.com --port 4312 --remote-token remote-token\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'endpoint', 'remove' ] is offline 1`] = `"Usage: opencove endpoint remove --endpoint-id <id> [options]\\n\\nRemove a registered endpoint\\n\\nOptions:\\n  --endpoint-id <id>  Select the endpoint (required)\\n\\nTable output (-o table): not supported.\\nProjectable fields: removedMountCount\\n\\nProjection example:\\n  opencove endpoint remove --endpoint-id '<id>' --fields removedMountCount\\n  {\\"removedMountCount\\":0}\\n\\nExamples:\\n  opencove endpoint remove --endpoint-id endpoint-id-123\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'fs', 'ls' ] is offline 1`] = `"Usage: opencove fs ls --uri <uri> [options]\\n\\nList a directory\\n\\nFile access is limited to approved roots. Run \\"opencove mount list --project <id>\\" to see approved root URIs; select a mount with --mount when needed.\\n\\nOptions:\\n  --uri <uri>   Select the absolute file:// URI of the file or directory (required)\\n  --mount <id>  Resolve the URI within this mount\\n\\nList output: --limit <n> keeps up to n items per list; 0 means all. Cut object lists add top-level truncated totals; bare arrays keep their shape and write one stderr notice. Cut tables also write one stderr notice.\\n\\nTable output (-o table): not supported.\\nProjectable fields: name, uri, kind\\n\\nProjection example:\\n  opencove fs ls --uri file:///repo --fields name\\n  {\\"entries\\":[{\\"name\\":\\"README.md\\"}]}\\n\\nExamples:\\n  opencove fs ls --uri file:///workspace/\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'fs', 'read' ] is offline 1`] = `"Usage: opencove fs read --uri <uri> [options]\\n\\nRead a text file\\n\\nFile access is limited to approved roots. Run \\"opencove mount list --project <id>\\" to see approved root URIs; select a mount with --mount when needed.\\n\\nOptions:\\n  --uri <uri>   Select the absolute file:// URI of the file or directory (required)\\n  --mount <id>  Resolve the URI within this mount\\n\\nTable output (-o table): not supported.\\nProjectable fields: content\\n\\nProjection example:\\n  opencove fs read --uri file:///repo/README.md --fields content\\n  {\\"content\\":\\"Hello\\"}\\n\\nExamples:\\n  opencove fs read --uri file:///workspace/notes.txt\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'fs', 'stat' ] is offline 1`] = `"Usage: opencove fs stat --uri <uri> [options]\\n\\nInspect file metadata\\n\\nFile access is limited to approved roots. Run \\"opencove mount list --project <id>\\" to see approved root URIs; select a mount with --mount when needed.\\n\\nOptions:\\n  --uri <uri>   Select the absolute file:// URI of the file or directory (required)\\n  --mount <id>  Resolve the URI within this mount\\n\\nTable output (-o table): not supported.\\nProjectable fields: uri, kind, sizeBytes, mtimeMs\\n\\nProjection example:\\n  opencove fs stat --uri file:///repo --fields kind\\n  {\\"kind\\":\\"directory\\"}\\n\\nExamples:\\n  opencove fs stat --uri file:///workspace/notes.txt\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'fs', 'write' ] is offline 1`] = `"Usage: opencove fs write --uri <uri> --content <text> [options]\\n\\nWrite a text file\\n\\nFile access is limited to approved roots. Run \\"opencove mount list --project <id>\\" to see approved root URIs; select a mount with --mount when needed.\\n\\nOptions:\\n  --uri <uri>              Select the absolute file:// URI of the file or directory (required)\\n  --mount <id>             Resolve the URI within this mount\\n  --content <text>         Write these exact UTF-8 contents (required)\\n  --content-file <path|->  Read content from a UTF-8 file, or use - for stdin\\n\\nTable output (-o table): not supported.\\nProjectable fields: uri, bytes\\n\\nProjection example:\\n  opencove fs write --uri '<uri>' --content '<text>' --fields uri\\n  {\\"uri\\":\\"file:///repo/notes.txt\\"}\\n\\nExamples:\\n  opencove fs write --uri file:///workspace/notes.txt --content-file ./notes.txt\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'mount', 'create' ] is offline 1`] = `"Usage: opencove mount create [--project <id>] --endpoint-id <id> --root-path <path> [options]\\n\\nMount a worker folder in a project\\n\\nWhen no project is given, inside OpenCove defaults to your own project.\\n\\nOptions:\\n  --project <id>      Select the project; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required outside OpenCove)\\n  --endpoint-id <id>  Select the endpoint (required)\\n  --root-path <path>  Mount this absolute folder path (required)\\n  --name <name>       Name the mount\\n\\nTable output (-o table): not supported.\\nProjectable fields: mountId, projectId, name, sortOrder, endpointId, targetId, rootPath, rootUri, createdAt, updatedAt\\n\\nProjection example:\\n  opencove mount create --project '<id>' --endpoint-id '<id>' --root-path '<path>' --fields mountId\\n  {\\"mount\\":{\\"mountId\\":\\"m\\"}}\\n\\nExamples:\\n  opencove mount create --project project-123 --endpoint-id endpoint-id-123 --root-path /workspace\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

exports[`help for [ 'mount', 'list' ] is offline 1`] = `"Usage: opencove mount list [--project <id>] [options]\\n\\nList project mounts\\n\\nWhen no project is given, inside OpenCove defaults to your own project.\\n\\nOptions:\\n  --project <id>  Select the project; also accepts @self, an exact name or a unique ID prefix (6+ characters) (required outside OpenCove)\\n\\nList output: --limit <n> keeps up to n items per list; 0 means all. Cut object lists add top-level truncated totals; bare arrays keep their shape and write one stderr notice. Cut tables also write one stderr notice.\\n\\nTable output (-o table): not supported.\\nProjectable fields: mountId, projectId, name, sortOrder, endpointId, targetId, rootPath, rootUri, createdAt, updatedAt\\n\\nProjection example:\\n  opencove mount list --project p --fields mountId,rootUri\\n  {\\"projectId\\":\\"p\\",\\"mounts\\":[{\\"mountId\\":\\"m\\",\\"rootUri\\":\\"file:///repo\\"}]}\\n\\nExamples:\\n  opencove mount list --project project-123\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

