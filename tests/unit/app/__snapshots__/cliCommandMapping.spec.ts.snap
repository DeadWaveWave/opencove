exports[`help for [ 'plugin', 'run' ] is offline 1`] = `"Usage: opencove plugin run <id> <command> [options]\\n\\nRun a plugin command\\n\\nInside OpenCove, window commands without an explicit node or project default to your own project. Plugin-wide commands receive no default target.\\n\\nOptions:\\n  --project <id>          Select the project; also accepts @self, an exact name or a unique ID prefix (6+ characters)\\n  --node <id>             Select an existing plugin window; also accepts @self, @parent, an exact name or a unique ID prefix (6+ characters)\\n  --view <id>             Select the plugin view\\n  --params <json>         Pass command parameters as JSON\\n  --params-file <path|->  Read params from a UTF-8 file, or use - for stdin\\n  --space <selector>      Require every node selector, including full IDs, to belong to this space; also accepts @self, an exact name or a unique ID prefix (6+ characters)\\n\\nTable output (-o table): not supported.\\nField projection (--fields): not supported. Plugin commands define their own results, so fields cannot be validated before execution. Omit --fields to receive the complete result.\\n\\nExamples:\\n  opencove plugin run sample status\\n\\nGlobal options: see \\"opencove --help\\".\\n"`;

