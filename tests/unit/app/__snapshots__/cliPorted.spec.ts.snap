exports[`help for [ 'endpoint', 'list' ] is offline 1`] = `
"Usage: opencove endpoint list [options]

List registered endpoints

Examples:
  opencove endpoint list

Global options: see "opencove --help".
"
`;

exports[`help for [ 'endpoint', 'ping' ] is offline 1`] = `
"Usage: opencove endpoint ping --endpoint-id <id> [options]

Check a remote worker connection

Options:
  --endpoint-id <id>   Select the endpoint (required)
  --ping-timeout <ms>  Limit the remote ping duration

Examples:
  opencove endpoint ping --endpoint-id endpoint-id-123

Global options: see "opencove --help".
"
`;

exports[`help for [ 'endpoint', 'register' ] is offline 1`] = `
"Usage: opencove endpoint register --hostname <host> --port <port> --remote-token <token> [options]

Register a remote worker

Options:
  --hostname <host>       Connect to this worker host (required)
  --port <port>           Connect to this worker port (required)
  --remote-token <token>  Authenticate with the remote worker token (required)
  --display-name <name>   Name the worker connection

Examples:
  opencove endpoint register --hostname worker.example.com --port 4312 --remote-token remote-token

Global options: see "opencove --help".
"
`;

