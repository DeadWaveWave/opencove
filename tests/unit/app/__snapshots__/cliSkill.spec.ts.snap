// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`makes skill discoverable on the last line of root help and provides offline help 1`] = `
"Usage: opencove skill [options]

Print the agent usage guide bundled with this CLI version

Prints SKILL.md as plain text without connecting to a Worker. -o json returns {version, content}; --fields projects those fields.

Table output (-o table): not supported.
Projectable fields: version, content

Projection example:
  opencove skill --fields version
  {"version":"0.4.0"}

Examples:
  opencove skill
  opencove skill -o json

Global options: see "opencove --help".
"
`;
