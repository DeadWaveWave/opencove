// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`makes skill discoverable on the last line of root help and provides offline help 1`] = `
"Usage: opencove skill [topic] [options]

Print the agent usage guide bundled with this CLI version

Print the core guide, or select a topic: canvas, coordinate, wait, read, access, events. All guides are bundled and available offline. -o json returns {version, content}, plus topic when selected; --fields projects those fields.

Table output (-o table): not supported.
Projectable fields: version, content, topic

Projection example:
  opencove skill --fields version
  {"version":"0.5.0"}

Examples:
  opencove skill
  opencove skill coordinate
  opencove skill read -o json

Global options: see "opencove --help".
"
`;
