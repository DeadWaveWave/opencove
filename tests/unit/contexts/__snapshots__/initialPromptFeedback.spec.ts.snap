exports[`file reference keeps codes/reasons and shows focused bilingual recovery 1`] = `
{
  "en": "This prompt contains the file reference "@README.md", whose access has not been verified. Read an approved file with opencove fs read --uri file:///workspace/README.md --fields content (replace the URI with the file’s absolute URI), then paste its content into the prompt, for example “Explain this file: …”.",
  "hint": "Read an approved file with opencove fs read --uri file:///workspace/README.md --fields content (replace the URI with the file’s absolute URI), then paste its content into the prompt, for example “Explain this file: …”.",
  "message": "This prompt contains the file reference "@README.md", whose access has not been verified.",
  "zhCN": "这段提示包含文件引用 "@README.md"，但尚未确认是否有权读取该文件。 请先用 opencove fs read --uri file:///workspace/README.md --fields content 读取已批准的文件（将 URI 替换为该文件的绝对 URI），再把 content 中的内容粘贴到提示中，例如“解释以下文件内容：……”。",
}
`;

