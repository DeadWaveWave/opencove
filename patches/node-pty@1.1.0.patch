+// This function must only run in a dedicated observer process: Console attachment is global.
+static Napi::Value ApiConsoleGeometry(const Napi::CallbackInfo& info) {
+  Napi::Env env(info.Env());
+  if (info.Length() != 1 || !info[0].IsNumber()) {
+    throw Napi::Error::New(env, "Usage: getConsoleGeometry(shellPid)");
+  }
+  const double rawPid = info[0].As<Napi::Number>().DoubleValue();
+  const DWORD pid = info[0].As<Napi::Number>().Uint32Value();
+  if (pid == 0 || pid == ATTACH_PARENT_PROCESS || rawPid != static_cast<double>(pid)) {
+    throw Napi::Error::New(env, "Invalid Console PID");
+  }
+
+  FreeConsole();
+  if (!AttachConsole(pid)) {
+    throw Napi::Error::New(env, "AttachConsole failed: " + std::to_string(GetLastError()));
+  }
+  HANDLE output = CreateFileW(L"CONOUT$", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                              nullptr, OPEN_EXISTING, 0, nullptr);
+  CONSOLE_SCREEN_BUFFER_INFO geometry{};
+  const BOOL succeeded = output != INVALID_HANDLE_VALUE && GetConsoleScreenBufferInfo(output, &geometry);
+  const DWORD error = succeeded ? 0 : GetLastError();
+  if (output != INVALID_HANDLE_VALUE) CloseHandle(output);
+  const BOOL detached = FreeConsole();
+  if (!succeeded || !detached) {
+    throw Napi::Error::New(env, "Console geometry query failed: " + std::to_string(error));
+  }
+
+  auto result = Napi::Object::New(env);
+  result.Set("cols", Napi::Number::New(env, geometry.srWindow.Right - geometry.srWindow.Left + 1));
+  result.Set("rows", Napi::Number::New(env, geometry.srWindow.Bottom - geometry.srWindow.Top + 1));
+  result.Set("bufferCols", Napi::Number::New(env, geometry.dwSize.X));
+  result.Set("bufferRows", Napi::Number::New(env, geometry.dwSize.Y));
+  return result;
+}
+
 Napi::Object init(Napi::Env env, Napi::Object exports) {
   exports.Set("getConsoleProcessList", Napi::Function::New(env, ApiConsoleProcessList));
+  exports.Set("getConsoleGeometry", Napi::Function::New(env, ApiConsoleGeometry));
   return exports;
 };
 
