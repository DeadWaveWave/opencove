+++ b/src/windowsConsoleGeometry.ts
@@ -0,0 +1,25 @@
+/** OpenCove extension to node-pty (MIT). Only use in a dedicated observer process. */
+import { loadNativeModule } from './utils';
+
+export interface IWindowsConsoleGeometry {
+  cols: number;
+  rows: number;
+  bufferCols: number;
+  bufferRows: number;
+}
+
+export function assertWindowsConsoleGeometryAvailable(): void {
+  if (process.platform !== 'win32' ||
+      typeof loadNativeModule('conpty_console_list').module.getConsoleGeometry !== 'function') {
+    throw new Error('Windows Console geometry capability missing; rebuild node-pty from source');
+  }
+}
+
+/** Attach/read/detach is process-global: never call this from the PTY host or app process. */
+export function readWindowsConsoleGeometry(pid: number): IWindowsConsoleGeometry {
+  if (!Number.isInteger(pid) || pid <= 0 || pid >= 0xffffffff) {
+    throw new Error('Invalid Windows Console PID');
+  }
+  assertWindowsConsoleGeometryAvailable();
+  return loadNativeModule('conpty_console_list').module.getConsoleGeometry(pid);
+}
